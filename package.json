{
	"name": "titan-tracker",
	"version": "1.0.0",
	"private": true,
	"description": "Live stat tracker for Food Network's Bobby's Triple Threat",
	"homepage": "https://triple-threat.vercel.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/nikhilNathwani/Titan-Tracker"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"prepare": "git config core.hooksPath .githooks || true",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"nextjs",
		"react",
		"typescript",
		"postgresql",
		"sports-stats"
	],
	"author": "Nikhil Nathwani (https://nikhilnathwani.com)",
	"license": "ISC",
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.2.0",
		"@fortawesome/free-solid-svg-icons": "^7.2.0",
		"@fortawesome/react-fontawesome": "^3.3.1",
		"next": "^16.3.6",
		"pg": "^8.12.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@types/node": "^24.19.0",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"prettier": "^3.9.9",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": "24.x"
	},
	"prettier": {
		"useTabs": true,
		"tabWidth": 4
	}
}
